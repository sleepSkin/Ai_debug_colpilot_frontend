// 职责说明：定义 Next 侧数据库模型，用于会话与调试结果持久化。
// 调用链：Next API Routes -> Prisma Client -> PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String?
  title            String?
  lastStatus       String?
  lastRoundIndex   Int      @default(0)
  lastErrorMessage String?

  messages Message[]
  stepAttempts StepAttempt[]
}

model Message {
  id             String      @id @default(uuid())
  sessionId      String
  role           String
  roundIndex     Int?
  language       String
  errorText      String
  codeSnippet    String
  assistantJson  Json?
  rawModelOutput String?
  status         String      @default("success")
  errorCode      String?
  errorMessage   String?
  schemaVersion  String?
  metadata       Json?
  createdAt      DateTime    @default(now())

  session     Session     @relation(fields: [sessionId], references: [id])
  debugResult DebugResult?

  @@index([sessionId, roundIndex, role])
}

model DebugResult {
  messageId      String   @id
  sessionId      String?
  roundIndex     Int?
  errorType      String
  rootCause      String[]
  fixSuggestions String[]
  prevention     String[]
  rawModelOutput String?
  modelName      String?
  promptVersion  String?
  status         String   @default("success")
  errorCode      String?
  errorMessage   String?
  schemaVersion  String?
  metadata       Json?
  createdAt      DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([sessionId, roundIndex])
}

model StepAttempt {
  id           String   @id @default(uuid())
  sessionId    String
  roundIndex   Int
  stepType     String
  attempt      Int      @default(1)
  status       String
  errorCode    String?
  errorMessage String?
  requestId    String
  durationMs   Int?
  payloadIn    Json?
  payloadOut   Json?
  createdAt    DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, roundIndex, stepType, attempt])
}
